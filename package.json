{
  "name": "fumeto-reader-plus",
  "private": true,
  "version": "0.7.3",
  "license": "GPL-3.0-only",
  "author": "FumetoDev <fumetoreaderdev@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/fumetodev/FumetoReaderPlus.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:android": "npm run build && node scripts/prune-android-embed.mjs",
    "build:debug-ui-fixtures": "VITE_FUMETO_DEBUG_UI_FIXTURES=1 vite build",
    "schemes:generate": "npx --yes esbuild scripts/generate-color-schemes.src.mjs --bundle --platform=node --format=esm --outfile=node_modules/.cache/fumeto/schemes-gen.mjs --log-level=error && node node_modules/.cache/fumeto/schemes-gen.mjs",
    "version:set": "node scripts/set-app-version.mjs",
    "release:preflight": "node scripts/release-preflight.mjs",
    "release:android": "node scripts/release-android.mjs",
    "release:collect": "node scripts/collect-android-artifact.mjs",
    "release:record": "node scripts/record-release.mjs",
    "preview": "vite preview",
    "prepare": "(svelte-kit sync || echo '') && node scripts/i18n-compile.mjs",
    "check": "node scripts/i18n-compile.mjs && svelte-kit sync && svelte-check --workspace ./src --tsconfig \"$PWD/tsconfig.check.json\" && node scripts/i18n-native-strings.mjs --check",
    "check:watch": "svelte-kit sync && svelte-check --workspace ./src --tsconfig \"$PWD/tsconfig.check.json\" --watch",
    "i18n:compile": "node scripts/i18n-compile.mjs",
    "i18n:draft": "node scripts/i18n-draft.mjs",
    "i18n:draft:dry": "node scripts/i18n-draft.mjs --dry-run",
    "i18n:draft:check": "node scripts/i18n-draft.mjs --check",
    "i18n:native": "node scripts/i18n-native-strings.mjs",
    "i18n:native:check": "node scripts/i18n-native-strings.mjs --check",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:android-dev": "tauri android dev",
    "tauri:android-build": "tauri android build",
    "audit:overlay-release": "node scripts/audit-overlay-release.mjs"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^2.24.1",
    "@inlang/plugin-message-format": "^4.4.3",
    "@material/material-color-utilities": "^0.4.0",
    "@sveltejs/adapter-auto": "^7.0.0",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.50.2",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/vite": "^4.1.18",
    "@tauri-apps/cli": "^2",
    "semver": "^7.8.5",
    "svelte": "^5.49.2",
    "svelte-check": "^4.3.6",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  },
  "dependencies": {
    "@chenglou/pretext": "0.0.8",
    "@fontsource/noto-emoji": "5.2.11",
    "@fontsource/noto-sans": "5.2.10",
    "@fontsource/noto-sans-arabic": "5.2.10",
    "@fontsource/noto-sans-devanagari": "5.2.8",
    "@fontsource/noto-sans-jp": "5.2.9",
    "@fontsource/noto-sans-kr": "5.2.9",
    "@fontsource/noto-sans-sc": "5.2.9",
    "@fontsource/noto-sans-symbols-2": "5.2.8",
    "@fontsource/noto-sans-tc": "5.2.9",
    "@fontsource/noto-sans-thai": "5.2.8",
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-dialog": "2.7.0",
    "@tauri-apps/plugin-fs": "2.5.0",
    "@tauri-apps/plugin-http": "^2.5.7",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@zip.js/zip.js": "^2.8.20",
    "dexie": "^4.3.0",
    "node-unrar-js": "^2.0.2",
    "onnxruntime-web": "1.27.0",
    "panzoom": "^9.4.3",
    "pdfjs-dist": "^5.5.207"
  }
}
