<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:name=".FumetoApplication"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.app"
        android:largeHeap="true"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <!--
            largeHeap raises the Java/Dalvik heap limit only. llama.cpp's
            Hy-MT2 1.8B 1.25-bit model lives in native (mmap'd) memory and is
            NOT affected by this flag. What largeHeap does buy us is extra
            headroom for OkHttp download buffers, WebView bitmap caches,
            and image-processing intermediates — the Java-side allocations
            that would otherwise compete for system RAM pressure alongside
            the native model. Supporting mitigation; the foreground service
            below (InferenceForegroundService) is the primary defense
            against LMKD eviction and CPU governor downclocking.
        -->

        <!-- Portrait is the default for the catalog, tabs and settings, which
             are portrait layouts. The reader lifts it to fullUser while it is on
             screen (AndroidBridge.setOrientationPolicy, driven by the frontend's
             appView), so a phone with auto-rotate on reads in landscape and one
             with rotation locked stays put. userPortrait still allows
             sensor-driven upside-down portrait. Android 16+ ignores this on
             large screens, where every view rotates regardless.

             configChanges lists every change this Activity can absorb, because it
             cannot survive being recreated: the Rust side treats onDestroy as the
             last window closing and exits the process, so an undeclared change
             (system font size, display size, bold text, a keyboard or SIM swap)
             closed the app mid-read, calling exit() while the replacement
             window was already coming up. The WebView re-lays itself out for
             each of these in place, as it already does for a rotation. -->
        <activity
            android:screenOrientation="userPortrait"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|density|fontScale|fontWeightAdjustment|layoutDirection|navigation|touchscreen|colorMode|mcc|mnc|grammaticalGender"
            android:launchMode="singleTask"
			android:windowSoftInputMode="adjustResize"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- "Open with" for a comic another app hands over (a file manager, a download): read
                 in the reader without being added to a library (opened-file.ts). Offered, never the
                 default. content: only — a file: address needs a storage permission the app does
                 not hold. Android's own type table calls .cbz application/x-cbz, IANA calls it
                 application/vnd.comicbook+zip, and every table knows .zip. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:mimeType="application/x-cbz" />
                <data android:mimeType="application/vnd.comicbook+zip" />
                <data android:mimeType="application/zip" />
                <data android:mimeType="application/x-zip-compressed" />
            </intent-filter>
            <!-- A provider whose table does not know .cbz (Android 8 and 9 among them) sends it as
                 application/octet-stream; the name is matched instead, where its address carries
                 one. A separate filter: in one, these paths would hold for the types above as well.
                 pathPattern does not backtrack, so `.*\\.cbz` alone misses a name with a dot
                 earlier in it: one pattern per earlier dot. pathSuffix would do it in one, but
                 Android 8-11 ignore it and would then match every unknown file. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:host="*" />
                <data android:mimeType="application/octet-stream" />
                <data android:pathPattern=".*\\.cbz" />
                <data android:pathPattern=".*\\..*\\.cbz" />
                <data android:pathPattern=".*\\..*\\..*\\.cbz" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.cbz" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\.cbz" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\..*\\..*\\.cbz" />
                <data android:pathPattern=".*\\.CBZ" />
                <data android:pathPattern=".*\\..*\\.CBZ" />
                <data android:pathPattern=".*\\..*\\..*\\.CBZ" />
                <data android:pathPattern=".*\\..*\\..*\\..*\\.CBZ" />
            </intent-filter>
        </activity>

        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        </provider>

        <!-- Translation foreground service: keeps process alive during batch translation -->
        <service
            android:name=".service.TranslationForegroundService"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="On-device ML inference for manga/comic translation. User-initiated batch processing (5-60 min per volume)." />
        </service>

        <!-- Llama inference foreground service: keeps the ~462 MB Hy-MT2 1.8B
             1.25-bit model (under 1 GB runtime working set) resident and the CPU governor hot while the user browses
             manga pages with the local translator active. Distinct from
             TranslationForegroundService which handles batch-job progress. -->
        <service
            android:name=".llama.InferenceForegroundService"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the local Hy-MT2 1.8B 1.25-bit translation model loaded while the user reads manga. Short bubble-translation bursts require the CPU governor to stay responsive and the process to avoid LMKD eviction (roughly under 1 GB runtime working set)." />
        </service>
    </application>
</manifest>
