{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "linux-desktop",
  "description": "Linux-only additions on top of the default set: library folder watching, streamed model downloads, real fullscreen, and file access on any path the folder picker accepts",
  "platforms": [
    "linux"
  ],
  "windows": [
    "main"
  ],
  "permissions": [
    "fs:allow-watch",
    "fs:allow-unwatch",
    "fs:allow-open",
    "fs:allow-write",
    "core:window:allow-set-fullscreen",
    {
      "identifier": "fs:scope",
      "allow": [
        {
          "path": "/"
        },
        {
          "path": "/**"
        }
      ]
    }
  ]
}
