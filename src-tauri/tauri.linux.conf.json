{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "build": {
    "beforeBuildCommand": "npm run build:desktop"
  },
  "app": {
    "windows": [
      {
        "title": "FumetoReaderPlus",
        "width": 1280,
        "height": 860,
        "minWidth": 800,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ]
  },
  "bundle": {
    "targets": [
      "appimage"
    ],
    "category": "GraphicsAndDesign",
    "shortDescription": "Manga and comic reader with AI translation",
    "longDescription": "Read manga, comics and EPUB books from local files or YACReader, Komga and Kavita servers, and translate them in place with an online provider or entirely on this computer.",
    "homepage": "https://github.com/fumetodev/FumetoReaderPlus",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  },
  "plugins": {
    "fs": {
      "requireLiteralLeadingDot": false
    }
  }
}
